# ============================================
# FoodFlow POS — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- MongoDB ---
MONGO_ROOT_USERNAME=foodflow
MONGO_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=DineDesk

# --- Backend ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ADMIN_EMAIL=admin@foodflow.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
LOG_LEVEL=INFO

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend URL (used in email links) ---
FRONTEND_URL=http://localhost:3000

# --- SMTP (optional — for email verification) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_EMAIL=support@revontechnologies.in
SENDER_NAME=DineDesk

# --- Email verification mode ---
# false (default): accounts are auto-verified at signup — instant login, works
#   with no email provider configured. Best for dev / self-hosting.
# true: signup requires clicking an emailed verification link (needs SendGrid
#   or Gmail below). Recommended only for SaaS production.
EMAIL_VERIFICATION_REQUIRED=false

# --- Restaurant timezone (IANA name) ---
# All day boundaries, analytics and peak-hour charts use this zone. Default: IST
RESTAURANT_TZ=Asia/Kolkata

# --- SendGrid (recommended — HTTPS API works on Render free tier, SMTP is blocked) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@revontechnologies.in
SENDGRID_FROM_NAME=DineDesk

# --- Twilio (optional — for SMS notifications) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Online-order webhook signatures (P0 security — endpoints fail CLOSED) ---
# /api/webhooks/swiggy and /api/webhooks/zomato stay 401 until their secret
# is set on BOTH sides. Sign requests as:
#   X-Webhook-Timestamp: <unix seconds>
#   X-Webhook-Signature: hex(HMAC_SHA256(secret, "<ts>.<raw_body>"))
# These are NOT real Swiggy/Zomato credentials — real partner integrations
# must provision their own secrets.
SWIGGY_WEBHOOK_SECRET=
ZOMATO_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECS=300

# --- Demo tenant seed (P0 security — default OFF) ---
# true ONLY in a dev/demo environment: seeds demo@dinedesk.in with a known
# password and a fully-active store. Never enable in production.
ENABLE_DEMO_ACCOUNT=false

# --- Google OAuth (for Google Sign-In) ---
REACT_APP_GOOGLE_CLIENT_ID=

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=80
