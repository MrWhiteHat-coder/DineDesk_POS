{
  "brand_identity": {
    "name": "DineDesk POS",
    "tone": "Calm, Hospitable, Precise, Warm",
    "archetype": "The Maître d’ — composed under pressure",
    "audience": "Restaurant Owners, Floor Staff, Kitchen Managers",
    "core_values": ["Speed", "Calm", "Accuracy", "Hospitality"]
  },
  "typography": {
    "headings": {
      "family": "Fraunces",
      "weights": ["500", "600", "700"],
      "usage": "Page titles, brand wordmark, hero lines."
    },
    "body": {
      "family": "Plus Jakarta Sans",
      "weights": ["400", "500", "600", "700"],
      "usage": "UI, tables, navigation, forms."
    },
    "numbers": {
      "family": "Plus Jakarta Sans",
      "weights": ["700"],
      "usage": "Prices, timers, order numbers — tabular nums."
    }
  },
  "colors": {
    "primary": {
      "name": "Service Navy",
      "hex": "#1B4F72",
      "usage": "Primary accent, selected states, charts"
    },
    "ink": {
      "name": "Floor Ink",
      "hex": "#101820",
      "usage": "Sidebar, primary buttons, headings"
    },
    "accent": {
      "name": "Hospitality Gold",
      "hex": "#D4A017",
      "usage": "Highlights, live indicators, brand mark"
    },
    "background": {
      "default": "#F3EEE6",
      "paper": "#FFFCF8",
      "sidebar": "#101820"
    },
    "functional": {
      "success": "#1A7A54",
      "warning": "#D4A017",
      "error": "#C23A2B",
      "info": "#1B4F72"
    }
  },
  "layout_strategy": {
    "pos_mode": {
      "structure": "Dark grouped sidebar on desktop; bottom nav + More on tablet/phone",
      "grid": "Menu bento: 2 / 3 / 4 / 6 columns",
      "spacing": "Touch targets min 40–48px",
      "navigation": "Floor / People / Money / Insights grouping"
    },
    "admin_dashboard": {
      "structure": "Ink sidebar + linen canvas",
      "container": "Fluid, padded 24px"
    }
  },
  "universal_guidelines": [
    "Do NOT use default blue or generic black-on-white SaaS chrome.",
    "Do NOT use Inter for headings. Use Fraunces.",
    "Primary actions are ink. Accents are saffron. Kitchen heat is terracotta.",
    "Use sonner for toasts.",
    "Night Shift remaps surfaces for low-light service."
  ]
}
